{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    },
    "ThreadTokenUsage": {
      "properties": {
        "effectiveModel": {
          "description": "Effective request settings for the latest accounted response.",
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveReasoningEffort": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveServiceTier": {
          "type": [
            "string",
            "null"
          ]
        },
        "last": {
          "allOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            }
          ],
          "description": "Latest provider/context-window sample retained for compatibility."
        },
        "latestTurn": {
          "allOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            }
          ],
          "default": {
            "cacheWriteInputTokens": 0,
            "cachedInputTokens": 0,
            "inputTokens": 0,
            "outputTokens": 0,
            "reasoningOutputTokens": 0,
            "totalTokens": 0
          },
          "description": "Cumulative usage for the latest logical turn."
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "allOf": [
            {
              "$ref": "#/definitions/TokenUsageBreakdown"
            }
          ],
          "description": "Cumulative usage for the canonical thread across all completed responses."
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cacheWriteInputTokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}